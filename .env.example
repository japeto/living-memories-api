# =============================================================================
# Application settings
# =============================================================================
PROJECT_NAME="Mi Recuerdo Vivo API"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# =============================================================================
# Supabase — required for data persistence (PostgreSQL + Storage)
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
# Anon key: request-scoped access that respects Row Level Security.
SUPABASE_KEY=your-supabase-anon-key
# Service-role key: server-side privileged operations only. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Storage bucket holding the voice-message audio files.
SUPABASE_STORAGE_BUCKET=memories-audio
# Shared timeout (seconds) for the PostgREST and Storage sub-clients.
SUPABASE_TIMEOUT=10

# =============================================================================
# AI Provider — required for transcription (Whisper) and NLP analysis
# =============================================================================
# AI_PROVIDER_KEY=your-ai-provider-key
